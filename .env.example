DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 如 DEEPSEEK_MODEL 不支持视觉输入，请配置一个支持图片输入的模型。
DEEPSEEK_VISION_MODEL=
# 可选：JSON 格式，例如 {"THB":4.65,"VND":3500}
ADLAB_CNY_RATES=
ADLAB_RATES_UPDATED_AT=
PORT=4173

# 豆包 / 火山引擎方舟生图配置（不要提交真实密钥）
ARK_API_KEY=
ARK_IMAGE_MODEL=
ARK_IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
ARK_IMAGE_SIZE=1024x1024
# 可选：异步任务接口；未配置时使用方舟默认路径
ARK_IMAGE_TASK_API_URL=
ARK_IMAGE_STATUS_API_URL=
